{
  "headers": [
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/deck", "destination": "/slides.pdf" },
    { "source": "/slides", "destination": "/slides.pdf" }
  ]
}
